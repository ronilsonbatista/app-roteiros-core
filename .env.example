DATABASE_URL="postgresql://user:password@localhost:5432/approteiros?schema=public"

# Autenticação
JWT_SECRET="secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Configurações de Inteligência Artificial
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps/Places
GOOGLE_MAPS_API_KEY=

# Upload de Mídia
MEDIA_STORAGE_PROVIDER=local
MEDIA_BASE_URL=http://localhost:3000/uploads
MEDIA_MAX_FILE_SIZE_MB=5

# Segurança e Deploy
CORS_ORIGINS="*"
SWAGGER_ENABLED="true"

# Seed Data Inicial
SEED_ADMIN_EMAIL=admin@approteiros.com
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_NAME=Admin
