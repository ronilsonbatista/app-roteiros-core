DATABASE_URL="postgresql://user:password@localhost:5432/approteiros?schema=public"

# Autenticação
JWT_SECRET="secret"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="refresh_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Configurações de Inteligência Artificial
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps/Places
GOOGLE_MAPS_API_KEY=

# URL pública do Core (usada nos iconUrl padrão do autocomplete de localidades).
# Em produção atrás de proxy, defina explicitamente (https).
PUBLIC_BASE_URL=http://localhost:3000

# Upload de Mídia (avatares e capas; limite menor que o banco de imagens)
MEDIA_STORAGE_PROVIDER=local
MEDIA_BASE_URL=http://localhost:3000/uploads
MEDIA_MAX_FILE_SIZE_MB=5

# Banco de imagens: PostgreSQL separado do DATABASE_URL e do Postgres do docker compose.
# Crie o database você mesmo (local ou servidor externo). Este repo não sobe esse Postgres.
IMAGE_BANK_DATABASE_URL="postgresql://image_bank_user:password@localhost:5432/image_bank"
# Arquivos ficam fora desse banco: disco local (padrão) ou um S3/R2 que você já tenha.
# Não há container de storage no docker compose.
# MEDIA_STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
IMAGE_BANK_MAX_FILE_SIZE_MB=25
IMAGE_BANK_SIGNED_URL_TTL_SECONDS=900
# IMAGE_BANK_PUBLIC_BASE_URL=

# Segurança e Deploy
CORS_ORIGINS="*"
SWAGGER_ENABLED="true"

# Billing / Carrinho (sem secrets reais no example)
# development: omit MERCADO_PAGO_* → MP test-token stub (PIX QR fake)
# ou BILLING_MOCK_PAYMENTS_ENABLED=true + PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER=mercadopago
BILLING_MOCK_PAYMENTS_ENABLED=false
# Wallets (Apple/Google Pay) — off até Ronilson configurar merchant + MP
WALLET_PAYMENTS_ENABLED=false
# Secrets (Railway / staging — NÃO commitar valores)
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_WEBHOOK_SECRET=
# MERCADO_PAGO_PUBLIC_KEY=   # Brick / card form (client)
# SEED_PRODUCT_PRICE=         # preço ITINERARY_FULL_ACCESS no seed

# Seed Data Inicial
SEED_ADMIN_EMAIL=admin@2go.com
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
