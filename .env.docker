PORT=3000

# Database
# Note o host 'db' (nome do service no docker-compose)
DATABASE_URL="postgresql://approteiros_user:approteiros_password@db:5432/approteiros_db?schema=public"

# Auth
JWT_SECRET="super_secret_docker_key_change_me"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Third Party
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GOOGLE_MAPS_API_KEY=""

# Media
MEDIA_STORAGE_PROVIDER="local"
MEDIA_BASE_URL="http://localhost:3000/uploads"
MEDIA_MAX_FILE_SIZE_MB="5"

# Segurança e Deploy
CORS_ORIGINS="*"
SWAGGER_ENABLED="true"

# Seed Data Inicial
SEED_ADMIN_EMAIL=admin@approteiros.com
SEED_ADMIN_PASSWORD=admin_docker_password
SEED_ADMIN_NAME=DockerAdmin
